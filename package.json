{
  "name": "tomo-extension",
  "private": true,
  "version": "1.3.1",
  "description": "Extensao Chrome local para organizar links e leituras por abas com capa automatica, progresso de capitulo e backup JSON.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "pack": "npm run build && node scripts/pack-release.mjs",
    "preview": "vite preview --port 4173 --strictPort",
    "test": "vitest run",
    "verify:contrast": "node scripts/verify-contrast.mjs",
    "generate:icons": "node scripts/generate-icons.mjs"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.2.0",
    "@fontsource-variable/jetbrains-mono": "^5.2.0",
    "@fontsource-variable/plus-jakarta-sans": "^5.2.0",
    "lucide-react": "^0.511.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.313",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.4.1",
    "typescript": "~5.8.3",
    "vite": "^6.3.5",
    "vitest": "^3.1.3"
  }
}
